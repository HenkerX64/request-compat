{
  "name": "request-compat",
  "description": "Drop-in replacement for the deprecated request 2.88.2: same API and behaviour, security fixes, tested on Node 6 to 26.",
  "keywords": [
    "request",
    "http",
    "https",
    "drop-in",
    "replacement",
    "deprecated",
    "migration",
    "compat",
    "security",
    "cve",
    "request-promise",
    "overrides"
  ],
  "version": "2.88.4",
  "author": "Mikeal Rogers <mikeal.rogers@gmail.com>",
  "homepage": "https://github.com/HenkerX64/request-compat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenkerX64/request-compat.git"
  },
  "bugs": {
    "url": "https://github.com/HenkerX64/request-compat/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">= 6"
  },
  "main": "index.js",
  "files": [
    "lib/",
    "index.js",
    "request.js"
  ],
  "dependencies": {
    "@postman/tunnel-agent": "0.6.3",
    "aws-sign2": "~0.7.0",
    "aws4": "^1.8.0",
    "caseless": "~0.12.0",
    "combined-stream": "~1.0.6",
    "extend": "~3.0.2",
    "forever-agent": "~0.6.1",
    "form-data": "~2.5.6",
    "http-signature": "~1.2.0",
    "is-typedarray": "~1.0.0",
    "isstream": "~0.1.2",
    "json-stringify-safe": "~5.0.1",
    "mime-types": "~2.1.19",
    "oauth-sign": "~0.9.0",
    "performance-now": "^2.1.0",
    "qs": "~6.5.2",
    "safe-buffer": "^5.1.2",
    "tough-cookie": "~2.5.0"
  },
  "scripts": {
    "test": "npm run lint && npm run test-ci",
    "test-ci": "taper tests/test-*.js",
    "test-cov": "nyc --reporter=lcov tape tests/test-*.js",
    "test-browser": "npm --prefix tests/browser install --ignore-scripts --no-package-lock --no-audit --no-fund && npm --prefix tests/browser start",
    "lint": "standard"
  },
  "devDependencies": {
    "bluebird": "^3.2.1",
    "buffer-equal": "^1.0.0",
    "nyc": "^14.1.1",
    "rimraf": "^2.2.8",
    "server-destroy": "^1.0.1",
    "standard": "^9.0.0",
    "tape": "^4.6.0",
    "taper": "^0.5.0"
  },
  "overrides": {
    "shelljs": "^0.8.5"
  }
}
